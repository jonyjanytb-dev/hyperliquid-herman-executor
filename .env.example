# Safe default: no real orders
DRY_RUN=true

# Exchange: hyperliquid or okx
EXCHANGE=hyperliquid

# Hyperliquid target (used when EXCHANGE=hyperliquid)
NETWORK=mainnet
DEX=xyz
COIN=xyz:XYZ100
INTERVAL=1m

# Main wallet / account address (0x...)
ACCOUNT_ADDRESS=
# API wallet private key created/authorized for trading (never withdrawal)
API_PRIVATE_KEY=

# OKX target (used when EXCHANGE=okx)
# This adapter currently supports linear USDT/USDC perpetual swaps only.
OKX_INST_ID=US100-USDT-SWAP
OKX_MARGIN_MODE=cross
OKX_TRIGGER_PRICE_TYPE=last
# true = OKX simulated trading; false = OKX production trading
OKX_DEMO=true
# API key should have Read + Trade permissions and no Withdraw permission.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
# Official origins: www.okx.com (Global), my.okx.com (EEA), app.okx.com (US)
OKX_BASE_URL=https://www.okx.com

# Position sizing: quote-currency notional per new trade (USDC on the
# Hyperliquid target; USDT or USDC according to the selected OKX instrument)
ORDER_NOTIONAL_USDC=100
# Optional leverage. 0 = do not change leverage automatically
LEVERAGE=0
# Market-order IOC price tolerance, decimal. 0.005 = 0.5%
MAX_SLIPPAGE=0.005

# Pine defaults — unchanged
SMA50_LENGTH=50
SMA200_LENGTH=200
POINT_SIZE=1.0
MIN_SEPARATION=30.0
ENABLE_LONGS=true
ENABLE_SHORTS=true
TP_MODE=200 SMA
SMA_TARGET_BEHAVIOUR=Dynamic
TP_FIXED_POINTS=100.0
SL_MODE=Fixed Points
SL_FIXED_POINTS=125.0

# Runtime
POLL_SECONDS=3
LOOKBACK_CANDLES=260
# Blank selects a separate runtime/state-<exchange>.json automatically.
STATE_PATH=
LOG_LEVEL=INFO
REQUEST_TIMEOUT=15
REQUEST_RETRY_ATTEMPTS=3
OKX_FILL_TIMEOUT=10

# Read-only mobile gateway
# Keep 127.0.0.1 for local-only access. For VPS/LAN access use 0.0.0.0
# together with a strong GATEWAY_TOKEN and HTTPS/reverse proxy.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787
GATEWAY_TOKEN=
GATEWAY_REFRESH_SECONDS=15
GATEWAY_HISTORY_DAYS=30
GATEWAY_BOT_STALE_SECONDS=150
