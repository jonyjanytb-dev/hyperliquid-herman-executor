# Safe default: no real orders
DRY_RUN=true

# Hyperliquid target
NETWORK=mainnet
DEX=xyz
COIN=xyz:XYZ100
INTERVAL=1m

# Main wallet / account address (0x...)
ACCOUNT_ADDRESS=
# API wallet private key created/authorized for trading (never withdrawal)
API_PRIVATE_KEY=

# Position sizing: notional USDC per new trade
ORDER_NOTIONAL_USDC=100
# Optional leverage. 0 = do not change leverage automatically
LEVERAGE=0
# Market-order IOC price tolerance, decimal. 0.005 = 0.5%
MAX_SLIPPAGE=0.005

# Pine defaults — unchanged
SMA50_LENGTH=50
SMA200_LENGTH=200
POINT_SIZE=1.0
MIN_SEPARATION=30.0
ENABLE_LONGS=true
ENABLE_SHORTS=true
TP_MODE=200 SMA
SMA_TARGET_BEHAVIOUR=Dynamic
TP_FIXED_POINTS=100.0
SL_MODE=Fixed Points
SL_FIXED_POINTS=125.0

# Runtime
POLL_SECONDS=3
LOOKBACK_CANDLES=260
STATE_PATH=runtime/state.json
LOG_LEVEL=INFO
